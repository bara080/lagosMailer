# Copy to .env and fill in. .env is gitignored — never commit real creds.

# Generic fallback SMTP (used when a company has no company-specific SMTP set).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASSWORD=your-app-password
MAILER_FROM=you@yourdomain.com

# Per-company SMTP / sender (multi-tenant). Each company sends from its own
# address. Prefix = company name uppercased with non-alphanumerics stripped:
#   LagosTSQ → LAGOSTSQ_*,  Native125th → NATIVE125TH_*
# Falls back to the generic SMTP_* above if a company var is unset.
LAGOSTSQ_SMTP_HOST=smtp.gmail.com
LAGOSTSQ_SMTP_PORT=587
LAGOSTSQ_SMTP_USER=
LAGOSTSQ_SMTP_PASSWORD=
LAGOSTSQ_MAILER_FROM=
NATIVE125TH_SMTP_HOST=smtp.gmail.com
NATIVE125TH_SMTP_PORT=587
NATIVE125TH_SMTP_USER=
NATIVE125TH_SMTP_PASSWORD=
NATIVE125TH_MAILER_FROM=

# Telnyx bulk SMS (https://portal.telnyx.com). Generic + per-company (same prefix
# scheme as SMTP). Provide a TELNYX_FROM (+E.164 number) OR a
# TELNYX_MESSAGING_PROFILE_ID (Telnyx number pool). Per-company falls back to generic.
TELNYX_API_KEY=
TELNYX_FROM=
TELNYX_MESSAGING_PROFILE_ID=
LAGOSTSQ_TELNYX_API_KEY=
LAGOSTSQ_TELNYX_FROM=
NATIVE125TH_TELNYX_API_KEY=
NATIVE125TH_TELNYX_FROM=

# Google Sheets sync (service account). Create a GCP service account, enable the
# Sheets API, and SHARE each company's sheet with the service account email.
# GOOGLE_PRIVATE_KEY is the PEM with newlines escaped as \n (keep the quotes).
# Sheet header row columns: email, name, business, category, phone, instagram, website, source
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Per-company sheet id (from the sheet URL /d/<THIS>/edit) + tab/range name.
LAGOSTSQ_SHEET_ID=
LAGOSTSQ_SHEET_RANGE=Sheet1
NATIVE125TH_SHEET_ID=
NATIVE125TH_SHEET_RANGE=Sheet1
# Generic fallback if a company has no specific sheet:
SHEET_ID=
SHEET_RANGE=Sheet1

# Auth / login (dashboard). Operator accounts — emails are fixed in
# app/api/auth/login/route.ts; set their passwords here.
#   baraahmad232@gmail.com → superadmin
#   googs000@gmail.com     → admin
# If a password var is unset it defaults to "admin" (fine for local dev only).
SUPERADMIN_EMAIL=baraahmad232@gmail.com
SUPERADMIN_PASSWORD=change-me
ADMIN_EMAIL=googs000@gmail.com
ADMIN_PASSWORD=change-me
# Secret used to HMAC-sign the session cookie. Set a long random value in prod.
SESSION_SECRET=change-me-to-a-long-random-string

# Supabase (Postgres) — the data layer. The server uses the SERVICE ROLE key,
# which bypasses RLS. On Vercel, the Supabase Marketplace integration provisions
# these automatically (SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, and the public
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
