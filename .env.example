# Copy to .env and fill in. .env is gitignored — never commit real creds.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASSWORD=your-app-password
MAILER_FROM=you@yourdomain.com

# Auth / login (dashboard). Single env-configured operator account.
# Defaults (used if unset) for local dev: admin@lagosmailer.com / admin
AUTH_EMAIL=admin@lagosmailer.com
AUTH_PASSWORD=admin
# Secret used to HMAC-sign the session cookie. Set a long random value in prod.
SESSION_SECRET=change-me-to-a-long-random-string

# Supabase (Postgres) — the data layer. The server uses the SERVICE ROLE key,
# which bypasses RLS. On Vercel, the Supabase Marketplace integration provisions
# these automatically (SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, and the public
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
